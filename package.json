{
  "name": "batmelech",
  "private": true,
  "description": "Bat Melech Kitchen — orders management system + website, served with basic auth and Postgres-backed state sync",
  "scripts": {
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:ai": "node --test tests/order-intake-ai.test.js",
    "test:security": "node --test tests/server-security.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "openai": "^6.49.0",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  }
}
